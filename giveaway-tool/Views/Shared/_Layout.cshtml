<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GT - @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CustomCss/gt-custom.css" asp-append-version="true" />
</head>
<body class="bg-secondary">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Icons/gt-icon.png" alt="Giveaway Tools" style="width:40px;height:36px" />
                    <span class="fw-bold">Giveaway Tools</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="javascript:void(0)" id="commentPicker" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Comment Picker
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="commentPicker">
                                <li><a class="dropdown-item" asp-action="YouTubeCommentPicker" asp-controller="Home">YouTube Videos</a></li>
                                <li><a class="dropdown-item disabled" href="javascript:void(0)">Instagram Post</a></li>
                                <li><a class="dropdown-item disabled" href="javascript:void(0)">Facebook Post</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle disabled" href="javascript:void(0)" id="videoDownloader" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Video Downloader
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="videoDownloader">
                                <li><a class="dropdown-item" href="javascript:void(0)">YouTube</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0)">Instagram</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0)">Facebook</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container pt-3">
            &copy; 2026 - GT - All Right Reserved | Designed & Developed By <a href="https://github.com/qevikas" target="_blank" style="text-decoration: none; color: #8a8aff"><i class="bi bi-github"></i> Vikas Shukla</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
