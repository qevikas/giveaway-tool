@{
	ViewBag.Title = "Giveaway Tools";
}

<link href="~/css/CustomCSS/comming-soon-cards.css" rel="stylesheet" />

<h3 class="py-4">Comment Picker From Video/Post URL</h3>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 py-2">

	<div class="col">
		<div class="coming-card">
			<div class="coming-card-body">
				<div class="coming-icon"><i class="bi bi-youtube text-danger"></i></div>
				<p class="mb-4">Pick comments from YouTube video by the video link for giveaway.</p>
				<a asp-action="YouTubeCommentPicker" asp-controller="Home" class="btn btn-gradient w-100 py-2"> Go To Page <i class="bi bi-hand-index"></i> </a>
			</div>
		</div>
	</div>

	<div class="col">
		<div class="coming-card">
			<div class="coming-card-body">
				<div class="coming-icon"><i class="bi bi-instagram instagram-icon-color"></i></div>
				<p class="mb-4">Pick comments from instagram post by the post link for giveaway.</p>
				<span class="badge-coming mt-2 d-inline-block">Coming Soon</span>
				@*<a href="/comment-picker/you-tube" class="btn btn-gradient w-100 py-2"> Go To Page <i class="bi bi-hand-index"></i> </a>*@
			</div>
		</div>
	</div>

	<div class="col">
		<div class="coming-card">

			<div class="coming-card-body">
				<div class="coming-icon"><i class="bi bi-facebook" style="color:#1877F2;"></i></div>
				<p class="mb-4">Pick comments from facebook post by the post link for giveaway.</p>
				<span class="badge-coming mt-2 d-inline-block">Coming Soon</span>
				@*<a href="/comment-picker/you-tube" class="btn btn-gradient w-100 py-2"> Go To Page <i class="bi bi-hand-index"></i> </a>*@
			</div>
		</div>
	</div>

</div>
<hr />
<h3 class="py-5">Download Videos From URL</h3>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 py-2">

	<div class="col">
		<div class="coming-card">
			<div class="coming-card-body">
				<div class="coming-icon text-danger"><i class="bi bi-youtube"></i></div>
				<p class="mb-4">Download YouTube videos instantly by pasting the video link.</p>
				<span class="badge-coming mt-2 d-inline-block">Coming Soon</span>
				@*<div class="small-note">Feature under development. Stay tuned!</div>*@
			</div>
		</div>
	</div>

</div>