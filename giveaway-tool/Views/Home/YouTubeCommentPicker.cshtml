@model CommentPicker
@{
	ViewBag.Title = "YouTube Video Comment Picker";
}

<div class="row" style="margin-top: 30px">
	<div class="col-12 col-md-8 mx-auto">
		<div class="picker-container">
			<h5 style="text-align: center;"><i class="bi bi-youtube text-danger"></i> Free YouTube Comment Picker and Giveaway Tool</h5>
			<p style="font-size: 12px; text-align: center;">You can select winners from your giveaway by using YouTube comment picker without login.</p>
			<form asp-action="YouTubeCommentPicker" asp-controller="Home" Method="Post">
				<div class="mb-3">
					<label asp-for="Input"></label>
					<input asp-for="Input" placeholder="Video URL" type="url" required />
					<span asp-validation-for="Input" class="text-danger"></span>
				</div>
				<div class="mb-3">
					<label asp-for="WinnerCount"></label>
					<input asp-for="WinnerCount" placeholder="No. of winners you want" type="number" required />
					<span asp-validation-for="WinnerCount" class="text-danger"></span>
				</div>

				<button type="submit">Pick Winner(s)</button>
			</form>

			@if (Model.Winners != null)
			{
				if (Model.Winners.Count > 0)
				{
					<!-- Winner Display -->
					<div class="winner-box">
						<h3><i class="bi bi-trophy text-warning"></i> Selected Winner(s)</h3>
						<ol>
							@foreach (var winner in Model.Winners)
							{
								<li class="mb-3">
									<div style="float: left">
										<img src="@winner.ProfileImageUrl" referrerpolicy="no-referrer" style="border-radius:50%; height:35px; width:35px;" />
									</div>
									<div style="padding-left: 40px;">
										<p><strong style="font-size: 13px;"> @winner.UserName</strong></p>
										<p style="font-size: 12px; margin-top: -5px">@Html.Raw(winner.CommentText)</p>
									</div>
								</li>
							}
						</ol>
					</div>
				}
				else
				{
					<div class="winner-box">
						<h3>Winner(s) Not Found</h3>
					</div>
				}
			}
		</div>
	</div>
</div>
@section Scripts{
	<partial name="_ValidationScriptsPartial" />
}